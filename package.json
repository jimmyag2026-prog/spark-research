{
  "name": "spark-research",
  "version": "0.2.0",
  "description": "面向科研人群的开源科研工作台：文献 → 思路 → 实验 → 记录 → 创新性核验 → 结论评审 → 报告",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "spark-research": "backend/src/index.ts"
  },
  "scripts": {
    "dev": "bun --watch backend/src/index.ts",
    "build": "bun run build:web && bun build backend/src/index.ts --compile --outfile dist/spark-research",
    "build:web": "vite build --config frontend/workspace/vite.config.ts",
    "dev:web": "vite --config frontend/workspace/vite.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p frontend/workspace/tsconfig.json",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:lab": "bun test tests/lab",
    "test:py": "python -m pytest tests/",
    "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
    "gen:llms": "bun scripts/gen-llms-txt.ts",
    "check:llms": "bun scripts/gen-llms-txt.ts --check"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "hono": "^4.6.0",
    "litellm": "^0.12.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.1.0",
    "solid-js": "^1.9.15",
    "typescript": "^5.6.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14"
  }
}
