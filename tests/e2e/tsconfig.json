{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ESNext",
      "DOM",
      "DOM.AsyncIterable"
    ],
    "types": [
      "bun"
    ],
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "**/*.ts",
    "../../backend/src/assets/assets.d.ts"
  ]
}
