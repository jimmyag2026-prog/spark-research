        "total": {
          "type": "number",
          "description": "本轮任务总数。plan 落地前是 0；进修正轮时加上修正任务数。"
        },
        "decision": {
          "enum": [
            "ready",
            "continue",
            "repair",
            "await_user"
          ]
        },
        "message": {
          "type": "string",
          "description": "人读文案。**前端唯一消费的字段**，必须自足（不依赖其它字段也能读懂）。"
        },
        "ts": {
          "type": "number",
          "description": "β-1（v0.10）：事件发出时刻（epoch ms）。\n前端此前只能用「收到的时刻」当时间戳——SSE 缓冲、页面卡顿、断线重连都会让它偏；\n而「这一阶段跑了多久」正是 v0.10 要上屏的东西，所以时间戳由产生事件的那一端给。"
        },
        "elapsedMs": {
          "type": "number",
          "description": "β-1：自 emitter 创建（= 本次请求开始）以来的毫秒数。**单调不减**。"
        },
        "etaMs": {
          "type": "number",
          "description": "β-1：预计剩余毫秒。**拿不准就没有这个字段**（任务书原话：eta 拿不准就不给字段）。\n唯一给得出的场景：execute 阶段、已完成 ≥ 1 个任务、且还有任务没完成——\n此时按「本会话内已完成任务的平均耗时 × 剩余任务数」外推。plan / summarize / review\n三段没有可外推的样本（每段只跑一次，且时长与任务数无关），一律不给。"
        }
      },
      "additionalProperties": false,
      "required": [
        "stage",
        "complete",
        "total",
        "message",
        "ts",
        "elapsedMs"
      ]
    },
    "ProgressStage": {
      "enum": [
        "review",
        "plan",
        "execute",
        "summarize"
      ]
    },
